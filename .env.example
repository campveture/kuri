# ─── Database — Lakebase Postgres (Neon) ─────────────────────────────────────
# `neon link` / `neon checkout <branch>` write these from the branch's env.
#   DATABASE_URL           pooled connection (host has "-pooler") — app runtime
#   DATABASE_URL_UNPOOLED  direct connection — Prisma migrations only
# Local Docker Postgres (docker compose up -d): set both to the same value.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Signs session cookies. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# ─── Site ────────────────────────────────────────────────────────────────────
# Absolute URL of the deployed site — used for metadataBase (OG/canonical URLs).
NEXT_PUBLIC_SITE_URL="https://kurivalley.vercel.app"

# ─── Object storage — admin image uploads ───────────────────────────────────
# Preferred: Neon Object Storage. `neon deploy` provisions the `uploads` bucket
# (from neon.ts) and `neon env pull` writes these AWS-standard vars:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
# NEON_UPLOADS_BUCKET="uploads"
#
# Fallback if the Neon project isn't in us-east-2 (Object Storage is beta / region-locked):
# BLOB_READ_WRITE_TOKEN=""      # Vercel Blob — auto-set when you add a Blob store
# (with neither set, uploads fall back to writing into /public/uploads — dev only)

# ─── Seed (optional) ─────────────────────────────────────────────────────────
# ADMIN_EMAIL="you@kuri.com.bd"
# ADMIN_PASSWORD="a-strong-password"
# SEED_SAMPLE_DATA="false"       # "false" = catalog + admin only, no demo orders
